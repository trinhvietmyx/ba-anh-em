# Development only. Keep real credentials out of this file.
API_HOST=127.0.0.1
API_PORT=3000
# Leave empty for the same-origin Vite proxy. Separate explicit origins with commas.
API_CORS_ORIGINS=

POSTGRES_DB=ba_anh_em
POSTGRES_USER=ba_anh_em
POSTGRES_PASSWORD=local_demo
POSTGRES_PORT=5432

# The migration role owns the schema; use a separate limited role for the API.
MIGRATION_DATABASE_URL=postgresql://ba_anh_em:local_demo@127.0.0.1:5432/ba_anh_em
DATABASE_URL=

# Set to the exact browser origin when enabling sessions (for example http://127.0.0.1:5173 locally).
APP_ORIGIN=
GUEST_SESSION_TTL_SECONDS=

# Configure all staff settings together after choosing an OIDC client and venue.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
STAFF_VENUE_CODE=
STAFF_SESSION_TTL_SECONDS=
STAFF_SESSION_IDLE_SECONDS=
# Requests per minute, per auth endpoint and peer, in each API process.
AUTH_RATE_LIMIT_PER_MINUTE=60

# Set a venue and opt into the PostgreSQL menu on the web.
MENU_VENUE_CODE=
VITE_MENU_SOURCE=demo

# Local booking fixture only. The API requires a loopback test database.
BOOKING_TEST_ENABLED=0
VITE_BOOKING_SOURCE=demo

# Set only while seeding a disposable test database.
BAE_TEST_SEED_DATABASE_URL=

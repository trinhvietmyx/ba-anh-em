# Development only. Keep real credentials out of this file.
API_HOST=127.0.0.1
API_PORT=3000
# Leave empty for the same-origin Vite proxy. Separate explicit origins with commas.
API_CORS_ORIGINS=

POSTGRES_DB=ba_anh_em
POSTGRES_USER=ba_anh_em
POSTGRES_PASSWORD=local_demo
POSTGRES_PORT=5432

# Optional to start the API. Readiness requires PostgreSQL 17 and the foundation schema.
DATABASE_URL=postgresql://ba_anh_em:local_demo@127.0.0.1:5432/ba_anh_em

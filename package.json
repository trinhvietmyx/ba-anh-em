{
  "name": "ba-anh-em",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm run dev --workspace=@ba-anh-em/web\" \"npm run dev --workspace=@ba-anh-em/api\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run build -w @ba-anh-em/api && playwright test",
    "contract:generate": "npm run build -w @ba-anh-em/api && node scripts/contract.mjs generate",
    "contract:check": "npm run build -w @ba-anh-em/api && node scripts/contract.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "ajv": "8.20.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}

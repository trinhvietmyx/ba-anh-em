{
  "name": "@ba-anh-em/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:integration": "npm run build && node --test \"test/integration/*.test.cjs\"",
    "db:migrate": "node dist/platform/db/database-cli.js migrate",
    "db:seed:test": "node dist/platform/db/database-cli.js seed-test",
    "db:seed:menu:test": "node dist/platform/db/database-cli.js seed-menu-test",
    "db:seed:booking:test": "node dist/platform/db/database-cli.js seed-booking-test",
    "db:validate:import": "node dist/platform/db/database-cli.js validate-import"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "kysely": "0.29.9",
    "openid-client": "6.9.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@ba-anh-em/api-contract": "0.0.0",
    "@nestjs/cli": "12.0.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  }
}
